{
  "name": "kasuminomori",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-search-index.mjs && next dev -p 3456",
    "build": "node scripts/extract-content.mjs && node scripts/build-search-index.mjs && node scripts/generate-redirects.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "extract": "node scripts/extract-content.mjs && node scripts/build-search-index.mjs",
    "search-index": "node scripts/build-search-index.mjs",
    "redirects": "node scripts/generate-redirects.mjs",
    "cleanup-legacy": "node scripts/cleanup-legacy-html.mjs",
    "test:e2e": "playwright test",
    "test:e2e:viewports": "playwright test e2e/ux-viewports.spec.ts",
    "test:e2e:headed": "playwright test --headed --workers=1",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:codegen": "playwright codegen http://localhost:3456/kasuminomori/",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "gsap": "^3.12.7",
    "lucide-react": "^0.511.0",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@eslint/eslintrc": "^3.3.1",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.3",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "@playwright/test": "^1.52.0"
  }
}
